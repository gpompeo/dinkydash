# Copy to .env and fill in. .env is gitignored and must never be committed.

# Optional: used to write a daily headline. Calendars and dashboard work without it.
ANTHROPIC_API_KEY=

# Optional parent sign-in. If a password is set, a private session key is required.
# Generate a key with: python3 -c "import secrets; print(secrets.token_hex(32))"
# DINKYDASH_PARENT_PASSWORD=
# DINKYDASH_SECRET_KEY=

# Optional feedback email. Use a send-only SendGrid key and a verified sender.
# SENDGRID_API_KEY=
# DINKYDASH_MAIL_FROM=
# DINKYDASH_MAIL_REPLY_TO=
# DINKYDASH_FEEDBACK_TO=

# Local development ports; Conductor uses CONDUCTOR_PORT and the next port.
# DINKYDASH_PORT=5000
# DINKYDASH_WEBSITE_PORT=5001
